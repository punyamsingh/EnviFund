# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — NEVER commit real secrets.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# anon/public key: safe to expose in the browser, but protect every table with Row Level Security
NEXT_PUBLIC_SUPABASE_KEY=your-supabase-anon-key

# --- Razorpay ---
# Key ID is publishable (used by the browser checkout)
NEXT_PUBLIC_RAZORPAY_KEY=***REMOVED***
# Key SECRET is server-only. Do NOT add a NEXT_PUBLIC_ prefix (that ships it to the browser).
RAZORPAY_SECRET=your-razorpay-key-secret

# --- Google OAuth (NextAuth) ---
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Client secret is server-only. Do NOT add a NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# NextAuth signing secret (server-only). Generate with: openssl rand -base64 32
JWT_SECRET=your-random-32-byte-secret

# --- Cron (Supabase keep-alive) ---
CRON_SECRET=your-cron-shared-secret
